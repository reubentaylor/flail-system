<div class="flail-chat-card shapeshift-revert-card">
  <header class="flail-chat-header shapeshift-header">
    <i class="fas fa-person"></i>
    {{#if forced}}
    <span>{{localize "FLAIL.Shapeshift.ForcedRevertTitle"}}</span>
    {{else}}
    <span>{{localize "FLAIL.Shapeshift.RevertTitle"}}</span>
    {{/if}}
  </header>
  <div class="flail-chat-body">
    <p class="shift-revert-line">
      <strong>{{actor.name}}</strong>
      {{#if forced}}
        {{localize "FLAIL.Shapeshift.ForcedRevertLine"}}
      {{else}}
        {{localize "FLAIL.Shapeshift.RevertLine"}}
      {{/if}}
      <span class="beast-name">({{beastForm}})</span>
    </p>

    {{#if roundNumber}}
    <div class="shift-run-summary">
      <span class="stat stat-round"><strong>{{localize "FLAIL.Shapeshift.RoundsSpent"}}</strong> {{roundNumber}}</span>
      <span class="stat stat-th"><strong>+TH</strong> {{thBonus}}</span>
      <span class="stat stat-dmg"><strong>+DMG</strong> {{dmgBonus}}</span>
    </div>
    {{/if}}

    {{#if rollHistory.length}}
    <div class="shift-dice-history">
      <h5>{{localize "FLAIL.Shapeshift.RoundHistory"}}</h5>
      <div class="shift-dice-row">
        {{#each rollHistory}}
        <span class="shift-die shift-die-{{this}}">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if saveOutcome}}
    <div class="shift-save">
      <h5>{{localize "FLAIL.Shapeshift.SaveHeader"}}</h5>
      <p class="shift-save-line">
        <strong>{{saveOutcome.attributeLabel}}</strong>
        ({{saveOutcome.score}})
        —
        {{#if saveOutcome.pass}}
        <span class="save-pass">{{localize "FLAIL.Shapeshift.SavePass"}} ({{saveOutcome.rolled}})</span>
        {{else}}
        <span class="save-fail">{{localize "FLAIL.Shapeshift.SaveFail"}} ({{saveOutcome.rolled}})</span>
        {{/if}}
      </p>
    </div>
    {{/if}}

    {{#if attrLoss}}
    <p class="shift-loss">
      <i class="fas fa-arrow-down"></i>
      {{localize "FLAIL.Shapeshift.AttributeLoss" attribute=attrLoss.label amount=attrLoss.amount}}
    </p>
    {{/if}}

    {{#if retire}}
    <p class="shift-retire">
      <i class="fas fa-skull"></i>
      {{localize "FLAIL.Shapeshift.RetireNotice"}}
    </p>
    {{/if}}
  </div>
</div>
