{{!--
  Background Picker (item-based).

  Layout:
    * Intro line naming the class (helps orient when picking).
    * "Custom Background" card at the top — special draggable that
      commits a copy of the Custom Background template item.
    * Numbered background cards below, filtered by class.
    * Currently-selected background gets a green outline.
--}}
<div class="background-picker-body">
  {{#if packMissing}}
  <p class="background-picker-intro">
    <strong>Backgrounds compendium not found.</strong> This is normal
    on first launch — reload the world once and the compendium will
    populate from the bundled entries.
  </p>
  {{else}}
  <p class="background-picker-intro">
    {{localize "FLAIL.BackgroundPicker.Intro"}}
    <strong>{{className}}</strong>.
  </p>
  {{/if}}

  {{#if hasCurrent}}
  <div class="background-picker-current-row">
    <button type="button" class="background-picker-clear-btn" data-action="clearBackground">
      <i class="fas fa-eraser"></i>
      {{localize "FLAIL.BackgroundPicker.ClearBackground"}}
    </button>
  </div>
  {{/if}}

  {{#if customCard}}
  <div class="bg-card bg-card-custom {{#if customCard.current}}bg-current{{/if}}"
       draggable="true"
       data-action="chooseBackground"
       data-item-uuid="{{customCard.uuid}}">
    <div class="bg-card-head">
      <i class="fas fa-user-edit bg-icon"></i>
      <span class="bg-name">{{customCard.name}}</span>
      {{#if customCard.current}}<i class="fas fa-check-circle bg-current-mark"></i>{{/if}}
    </div>
    <p class="bg-desc">{{localize "FLAIL.BackgroundPicker.CustomHint"}}</p>
  </div>
  {{/if}}

  <div class="bg-list">
    {{#each backgrounds as |bg|}}
    <div class="bg-card {{#if bg.current}}bg-current{{/if}}"
         draggable="true"
         data-action="chooseBackground"
         data-item-uuid="{{bg.uuid}}">
      <div class="bg-card-head">
        {{#if bg.sourceKey}}<span class="bg-key-badge">{{bg.sourceKey}}</span>{{/if}}
        <span class="bg-name">{{bg.name}}</span>
        {{#if bg.current}}<i class="fas fa-check-circle bg-current-mark"></i>{{/if}}
      </div>
      {{#if bg.description}}
      <div class="bg-desc">{{{bg.description}}}</div>
      {{/if}}
    </div>
    {{/each}}
  </div>

  <footer class="background-picker-footer">
    <p><i class="fas fa-hand-pointer"></i> {{localize "FLAIL.BackgroundPicker.Footer"}}</p>
  </footer>
</div>
