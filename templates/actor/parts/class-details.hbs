{{!--
  Class fundamentals reference card — Max HP, Weapon Specialty, Main Item,
  Armour Proficiency, Starting Gear. Strings come from the rules PDF and
  are resolved on the sheet as ctx.classDetails (an array of {label, value}).
  Same markup for every class; class-specific branches in class-extras.hbs
  decide where to slot it (top of panel, top-left of a side-by-side row, etc.).
--}}
<section class="tabbed-card class-details-card">
  <header class="tab-label">{{localize "FLAIL.Section.ClassDetails"}}</header>
  <dl class="class-details-list">
    {{#each classDetails as |row|}}
    <div class="class-detail-row">
      <dt>{{row.label}}</dt>
      <dd>{{row.value}}</dd>
    </div>
    {{/each}}
  </dl>
  {{#if startingGearAvailable}}
  <div class="starting-gear-row">
    {{#if startingGearImported}}
      <span class="starting-gear-imported"><i class="fas fa-check"></i> Starting gear imported</span>
      {{#if startingGearIsGm}}
      <button type="button" class="starting-gear-reset-btn" data-action="resetStartingGear"
              title="GM: reset the imported state (optionally delete tracked items).">
        <i class="fas fa-rotate-left"></i> Reset
      </button>
      {{/if}}
    {{else}}
      <button type="button" class="starting-gear-import-btn" data-action="openStartingGearWizard"
              {{#unless editable}}disabled{{/unless}}
              title="Open the wizard: import fixed items into your satchel, pick your weapon/instrument/etc., and roll starting coins.">
        <i class="fas fa-box-open"></i> Import Starting Gear
      </button>
    {{/if}}
  </div>
  {{/if}}
</section>
