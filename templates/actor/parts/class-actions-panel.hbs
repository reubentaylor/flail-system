{{!--
  Class Actions side panel — a compact strip on the Abilities tab
  surfacing the key class-specific clickable elements so players
  don't have to switch to the Class tab in the middle of combat.

  Each button dispatches to the same `data-action` handler the
  full Class tab uses. Tooltip content uses `data-tooltip` (Foundry
  native rich-tooltip attribute) with the same fields the Class tab
  reads (s.tooltipText / gadget.description / j.description / etc.),
  so hover popups on this panel match the Class tab exactly.

  Renders nothing for a class that has no notable Abilities-tab
  actions (or an unset class).
--}}
{{#if actor.system.class}}
<div class="tabbed-card class-actions-card">
  <header class="tab-label">{{localize "FLAIL.Section.ClassActions"}}</header>
  <div class="class-actions-body">

    {{!-- WARRIOR — Weathered toggle + read-only Combat Talents ------- --}}
    {{#if isWarrior}}
      <button type="button"
              class="ca-btn ca-weathered ca-weathered-{{#if system.weatheredAvailable}}available{{else}}unavailable{{/if}}"
              data-action="toggleWeathered"
              title="{{localize 'FLAIL.Warrior.WeatheredButton'}}"
              {{#unless editable}}disabled{{/unless}}>
        <i class="fas fa-{{#if system.weatheredAvailable}}check-circle{{else}}times-circle{{/if}} ca-icon"></i>
        <span class="ca-name">{{localize "FLAIL.Warrior.WeatheredButton"}}</span>
      </button>
      {{#each combatTalents as |slot|}}
        {{#if slot.currentDisplay}}
        <div class="ca-info ca-talent-info"
             data-tooltip="{{slot.currentDisplay.label}}">
          <span class="ca-tier-badge ca-tier-{{slot.currentDisplay.tier}}">{{slot.currentDisplay.tier}}</span>
          <span class="ca-name">{{slot.currentDisplay.label}}</span>
        </div>
        {{/if}}
      {{/each}}
    {{/if}}

    {{!-- WIZARD — Read Magic + cast each known spell -------------------- --}}
    {{#if isWizard}}
      <button type="button"
              class="ca-btn ca-read-magic"
              data-action="readMagic"
              title="{{localize 'FLAIL.Wizard.ReadMagicHint'}}"
              {{#unless editable}}disabled{{/unless}}>
        <i class="fas fa-scroll ca-icon"></i>
        <span class="ca-name">{{localize "FLAIL.Wizard.ReadMagicLabel"}}</span>
      </button>
      {{#each knownWizardSpells as |s|}}
      <button type="button"
              class="ca-btn ca-spell wizard-spell-{{s.tradition}}"
              data-action="castWizardSpell"
              data-item-id="{{s.id}}"
              data-tooltip="{{s.tooltipText}}"
              {{#unless ../editable}}disabled{{/unless}}>
        <img class="ca-img" src="{{s.img}}" alt="" />
        <span class="ca-name">{{s.name}}</span>
        <span class="ca-badge">{{s.suggestedDice}}d</span>
      </button>
      {{/each}}
      {{#unless knownWizardSpells.length}}
      <p class="ca-empty">{{localize "FLAIL.Wizard.SpellbookEmptyHint"}}</p>
      {{/unless}}
    {{/if}}

    {{!-- BONE WHISPERER — Animate Dead (INT save) + Dark Spells --------- --}}
    {{#if isBoneWhisperer}}
      <button type="button"
              class="ca-btn ca-summon"
              data-action="rollSave"
              data-attribute="int"
              title="{{localize 'FLAIL.BoneWhisperer.AnimateDead.Tooltip'}}"
              {{#unless editable}}disabled{{/unless}}>
        <i class="fas fa-skull ca-icon"></i>
        <span class="ca-name">{{localize "FLAIL.BoneWhisperer.AnimateDead.Label"}}</span>
      </button>
      {{#each knownDarkSpells as |s|}}
      <button type="button"
              class="ca-btn ca-spell dark-spell"
              data-action="castDarkSpell"
              data-item-id="{{s.id}}"
              data-tooltip="{{s.tooltipText}}"
              {{#unless ../editable}}disabled{{/unless}}>
        <img class="ca-img" src="{{s.img}}" alt="" />
        <span class="ca-name">{{s.name}}</span>
        <span class="ca-badge">{{s.suggestedDice}}d</span>
      </button>
      {{/each}}
    {{/if}}

    {{!-- CLERIC — Lay on Hands + Prayers --------------------------------- --}}
    {{#if isCleric}}
      <button type="button"
              class="ca-btn ca-lay-on-hands"
              data-action="layOnHands"
              title="{{localize 'FLAIL.LayOnHands.Tooltip'}}"
              {{#unless editable}}disabled{{/unless}}>
        <i class="fas fa-hand-holding-medical ca-icon"></i>
        <span class="ca-name">{{localize "FLAIL.LayOnHands.Title"}}</span>
      </button>
      {{#each knownDivinePrayers as |p|}}
      <button type="button"
              class="ca-btn ca-prayer"
              data-action="castPrayer"
              data-item-id="{{p.id}}"
              data-tooltip="{{p.tooltipText}}"
              {{#unless ../editable}}disabled{{/unless}}>
        <img class="ca-img" src="{{p.img}}" alt="" />
        <span class="ca-name">{{p.name}}</span>
      </button>
      {{/each}}
    {{/if}}

    {{!-- CUTTHROAT — Guild actions + Talents ---------------------------- --}}
    {{#if isCutthroat}}
      {{#if currentGuild}}
        {{#each currentGuild.specialActions as |a|}}
        <button type="button"
                class="ca-btn ca-guild-action"
                data-action="spendGuildAction"
                data-action-key="{{a.key}}"
                data-tooltip="{{a.description}}"
                {{#unless ../editable}}disabled{{/unless}}>
          <i class="fas fa-fingerprint ca-icon"></i>
          <span class="ca-name">{{a.name}}</span>
        </button>
        {{/each}}
      {{/if}}
      {{#each selectedTalents as |t|}}
      <button type="button"
              class="ca-btn ca-talent"
              data-action="rollTalent"
              data-talent="{{t.key}}"
              data-tooltip="{{t.desc}}"
              title="{{t.rollHint}}"
              {{#unless ../editable}}disabled{{/unless}}>
        <i class="fas fa-mask ca-icon"></i>
        <span class="ca-name">{{t.label}}</span>
        <span class="ca-badge ca-save-{{t.save}}">{{t.saveLabel}}</span>
      </button>
      {{/each}}
    {{/if}}

    {{!-- DRUID — Shapeshift + Primal Gifts ------------------------------ --}}
    {{#if isDruid}}
      {{#if shapeshift.active}}
        <button type="button"
                class="ca-btn ca-shapeshift-roll"
                data-action="shapeshiftRoll"
                title="{{localize 'FLAIL.Shapeshift.RollButtonHint'}}"
                {{#unless editable}}disabled{{/unless}}>
          <i class="fas fa-paw ca-icon"></i>
          <span class="ca-name">{{localize "FLAIL.Shapeshift.RollRoundButton"}}</span>
        </button>
        <button type="button"
                class="ca-btn ca-shapeshift-revert"
                data-action="shapeshiftRevert"
                title="{{localize 'FLAIL.Shapeshift.RevertButtonHint'}}"
                {{#unless editable}}disabled{{/unless}}>
          <i class="fas fa-user ca-icon"></i>
          <span class="ca-name">{{localize "FLAIL.Shapeshift.RevertButton"}}</span>
        </button>
      {{else}}
        <button type="button"
                class="ca-btn ca-shapeshift-start"
                data-action="shapeshiftStart"
                title="{{localize 'FLAIL.Shapeshift.StartButtonHint'}}"
                {{#unless editable}}disabled{{/unless}}>
          <i class="fas fa-paw ca-icon"></i>
          <span class="ca-name">{{localize "FLAIL.Shapeshift.StartButton"}}</span>
        </button>
      {{/if}}
      {{#each knownPrimalGiftsByKingdom as |kingdom|}}
        {{#each kingdom.gifts as |gift|}}
        <button type="button"
                class="ca-btn ca-gift"
                data-action="activateGift"
                data-item-id="{{gift.id}}"
                data-tooltip="{{gift.description}}"
                {{#unless ../../editable}}disabled{{/unless}}>
          <img class="ca-img" src="{{gift.img}}" alt="" />
          <span class="ca-name">{{gift.name}}</span>
        </button>
        {{/each}}
      {{/each}}
    {{/if}}

    {{!-- TINKERER — Gadgets --------------------------------------------- --}}
    {{#if isTinkerer}}
      {{#each knownGadgetsByCategory as |category|}}
        {{#each category.gadgets as |gadget|}}
        <button type="button"
                class="ca-btn ca-gadget {{#if gadget.used}}ca-gadget-used{{/if}}"
                data-action="useDamageGadget"
                data-item-id="{{gadget.id}}"
                data-tooltip="{{gadget.description}}"
                {{#if gadget.used}}disabled{{/if}}
                {{#unless ../../editable}}disabled{{/unless}}>
          <img class="ca-img" src="{{gadget.img}}" alt="" />
          <span class="ca-name">{{gadget.name}}</span>
        </button>
        {{/each}}
      {{/each}}
    {{/if}}

    {{!-- BARD — Instruments + JOAT --------------------------------------- --}}
    {{#if isBard}}
      {{#each inventory.instruments.slots as |slot|}}
        {{#if slot.item}}
          {{#if slot.itemUsedOut}}
          {{!-- Used-out this scene: button flips role from "play" to
               "reactivate" so the Bard can bring the instrument back
               without hunting for the tiny reset in the dedicated
               inventory zone. Green tint + rotate icon signals "ready
               to reset" state. --}}
          <button type="button"
                  class="ca-btn ca-instrument ca-instrument-used-out"
                  data-action="resetInstrumentUsedOut"
                  data-item-id="{{slot.item.id}}"
                  data-tooltip="{{localize 'FLAIL.Roll.InstrumentResetHint'}}"
                  {{#unless ../editable}}disabled{{/unless}}>
            <img class="ca-img" src="{{slot.item.img}}" alt="" />
            <span class="ca-name"><i class="fas fa-rotate-left"></i> {{slot.item.name}}</span>
          </button>
          {{else}}
          <button type="button"
                  class="ca-btn ca-instrument"
                  data-action="rollInstrument"
                  data-item-id="{{slot.item.id}}"
                  data-tooltip="{{slot.item.description}}"
                  {{#unless ../editable}}disabled{{/unless}}>
            <img class="ca-img" src="{{slot.item.img}}" alt="" />
            <span class="ca-name">{{slot.item.name}}</span>
          </button>
          {{/if}}
        {{/if}}
      {{/each}}
      {{#each jackOfAllTradesItems as |j|}}
      <button type="button"
              class="ca-btn ca-joat ca-joat-{{j.type}} {{#if j.usedToday}}ca-joat-used{{/if}}"
              data-action="{{#if (flail-eq j.type 'spell')}}castJoatSpell{{else if (flail-eq j.type 'gadget')}}useDamageGadget{{else}}toggleJoatUsed{{/if}}"
              data-item-id="{{j.id}}"
              data-tooltip="{{j.description}}"
              {{#unless ../editable}}disabled{{/unless}}>
        <img class="ca-img" src="{{j.img}}" alt="" />
        <span class="ca-name">{{j.name}}</span>
      </button>
      {{/each}}
    {{/if}}

    {{!-- Background Grants — cross-class items embedded via a
         background's crossClass grant. Available regardless of
         class since a Cleric prayer granted to a Bard, a Wizard
         spell granted to a Bone Whisperer, etc. all live here.
         Click dispatches to a type-appropriate handler (see
         backgroundGrantItems in character-sheet.mjs). --}}
    {{#if hasBackgroundGrantItems}}
    <div class="ca-section ca-bg-grants">
      <h4 class="ca-section-header">
        <i class="fas fa-scroll"></i>
        {{localize "FLAIL.Section.BackgroundGrants"}}
      </h4>
      {{#each backgroundGrantItems as |g|}}
      <button type="button"
              class="ca-btn ca-bg-grant ca-bg-grant-{{g.type}}"
              data-action="{{g.dataAction}}"
              data-item-id="{{g.id}}"
              data-tooltip="{{g.description}}"
              title="{{g.type}} (from {{g.source}} background grant)"
              {{#unless ../editable}}disabled{{/unless}}>
        <img class="ca-img" src="{{g.img}}" alt="" />
        <span class="ca-name">{{g.name}}</span>
        {{#if g.source}}<span class="ca-bg-grant-source">{{g.source}}</span>{{/if}}
      </button>
      {{/each}}
    </div>
    {{/if}}

  </div>
</div>
{{/if}}
