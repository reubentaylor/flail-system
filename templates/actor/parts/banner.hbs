{{!--
  Top banner. Portrait on the left, then class title + character name +
  background dropdown, then FLAIL mark and class select on the right.
  The portrait extends from the top-left corner down to the tabs bar.
--}}
<header class="char-banner">
  <div class="banner-row">
    <div class="banner-portrait" title="{{localize 'FLAIL.Field.PortraitHint'}}">
      <img
        class="portrait-img"
        src="{{actor.img}}"
        alt="{{actor.name}}"
        data-edit="img"
        data-action="editImage"
        title="{{localize 'FLAIL.Character.ChangePortrait'}}"
      />
    </div>
    <div class="banner-left">
      <h1 class="class-title">{{classLabel}}</h1>
      <input
        type="text"
        name="name"
        class="char-name"
        value="{{actor.name}}"
        placeholder="name"
        {{#unless editable}}disabled{{/unless}}
      />
      <div class="char-background">
        {{!--
          Background picker trigger + drop-target slot. Clicking the
          "Background:" header opens the picker window; the player can
          click a card in the picker OR drag one onto the slot below.
          When the slot is filled, the perk renders inline from the
          embedded background item's description. Editing the label +
          perk of a custom background is done via the item sheet
          (double-click the slot).
        --}}
        <div class="char-background-header">
          {{!-- Icon-only trigger — the scroll icon still opens the
               picker. The text label is dropped so the row's full
               width can go to the slot content (background name +
               key), maximizing readability. --}}
          <button type="button"
                  class="char-background-open-btn char-background-open-btn-iconic"
                  data-action="openBackgroundPicker"
                  title="{{localize 'FLAIL.BackgroundPicker.OpenPickerHint'}}"
                  {{#unless editable}}disabled{{/unless}}>
            <i class="fas fa-scroll"></i>
          </button>
          <div class="char-background-slot {{#if hasBackgroundItem}}bg-slot-filled{{else}}bg-slot-empty{{/if}}"
               data-flail-drop-target="background"
               {{#if hasBackgroundItem}}data-action="openBackgroundItem" data-item-id="{{backgroundItemId}}" title="{{localize 'FLAIL.BackgroundPicker.OpenSheetHint'}}"{{/if}}>
            {{#if hasBackgroundItem}}
              {{#if isCustomBackground}}
                <span class="bg-slot-key"><i class="fas fa-user-edit"></i></span>
              {{else if currentBackgroundKey}}
                <span class="bg-slot-key">{{currentBackgroundKey}}</span>
              {{/if}}
              <span class="bg-slot-label">{{currentBackgroundLabel}}</span>
            {{else}}
              <span class="bg-slot-placeholder">{{localize "FLAIL.BackgroundPicker.EmptySlotHint"}}</span>
            {{/if}}
          </div>
        </div>
        {{#if currentBackgroundPerk}}
        <div class="char-background-perk">{{{currentBackgroundPerk}}}</div>
        {{/if}}
        {{#if backgroundUnappliedGrantCount}}
        <button type="button"
                class="char-background-apply-btn"
                data-action="openBackgroundGrants"
                title="Walk through unapplied background grants (attribute mods, item grants, cross-class picks) with confirmation."
                {{#unless editable}}disabled{{/unless}}>
          <i class="fas fa-check-double"></i>
          {{#with backgroundUnappliedGrantCount as |count|}}
          Apply grants ({{count}})
          {{/with}}
        </button>
        {{/if}}
      </div>
    </div>
    <div class="banner-right">
      <span class="flail-mark">FLAIL<span class="bang">!</span></span>
      <select name="system.class" class="class-select" {{#unless editable}}disabled{{/unless}}>
        {{#each config.classes as |cls key|}}
        <option value="{{key}}" {{#if (flail-eq key ../classKey)}}selected{{/if}}>{{localize cls.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>
</header>
